rules_version = '2';
// 27 Kasım 2026'da Firebase konsolunda yayınlanan kurallar (eur3 veritabanı bu tarihte oluşturuldu).
// Her kullanıcı yalnızca kendi users/{uid} ağacını okuyup yazabilir.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
